    "responses": {
      "es": {
        "fundacredesa.que_es": [
          {
            "answer": "FUNDACREDESA (Fundación Centro de Estudios sobre Crecimiento y Desarrollo de la Población Venezolana) es una institución científica creada en 1976, pionera en el estudio biológico, psicológico y social del venezolano, orientando el desarrollo humano, la nutrición y el crecimiento de la Nación."
          }
        ],
        "fundacredesa.mision": [
          {
            "answer": "Dedicada a generar, divulgar y aplicar conocimientos científicos sobre el crecimiento, desarrollo físico y estado nutricional de la población venezolana en el contexto de sus condiciones de vida, para orientar la formulación de políticas públicas asertivas."
          }
        ],
        "fundacredesa.vision": [
          {
            "answer": "Ser el Centro de Investigación Científica de Referencia Nacional e Internacional, rector indiscutible en la generación de conocimiento bio-sicosocial de la población venezolana, con un equipo humano de altísimo nivel ético y excelencia."
          }
        ],
        "fundacredesa.presidente": [
          {
            "answer": "La Dra. Antonieta Caporale es la actual Presidenta de FUNDACREDESA, guiando a la institución bajo un enfoque de salud pública, investigación científica social y desarrollo humano."
          }
        ],
        "fundacredesa.ubicacion": [
          {
            "answer": "Nuestra sede principal se encuentra en Caracas, Venezuela. Desde allí coordinamos operativos y estudios a nivel nacional abarcando distintos estados del país."
          }
        ],
        "fundacredesa.proyectos": [
          {
            "answer": "Desarrollamos proyectos clave como PsicoEduca (salud mental en comunidades), Memory Vision (evaluación neuropsicológica virtual) y diversos censos sobre condiciones de vida, crecimiento físico y desarrollo psicomotor de los venezolanos."
          }
        ],
        "fundacredesa.psicoeduca": [
          {
            "answer": "PsicoEduca es un proyecto de FUNDACREDESA enfocado en la psicoeducación para promover la salud mental en comunidades venezolanas. Se centra en el diagnóstico y apoyo en casos de ansiedad, depresión e ideaciones suicidas."
          }
        ],
        "fundacredesa.memoryvision": [
          {
            "answer": "Memory Vision es un proyecto innovador de FUNDACREDESA para la evaluación cognitiva y neuropsicológica. Utiliza herramientas digitales para el monitoreo de la memoria y funciones ejecutivas en distintos grupos de edad."
          }
        ],
        "fundacredesa.contacto": [
          {
            "answer": "Puedes contactarnos escribiendo a fundacredesa5520@gmail.com o siguiéndonos en nuestras redes sociales: Instagram (@fundacredesa) y X/Twitter (@fundacredesa_)."
          }
        ],
        "saludo": [
          {
            "answer": "¡Hola! Soy la Inteligencia Artificial de FUNDACREDESA. Estoy listo para responder cualquier pregunta sobre nuestros estudios, historia, proyectos y autoridades. ¿En qué puedo ayudarte?"
          }
        ],
        "despedida": [
          {
            "answer": "¡Hasta luego! Recuerda que FUNDACREDESA está aquí para velar por el desarrollo bio-psicosocial de Venezuela. ¡Vuelve pronto!"
          }
        ],
        "agradecimiento": [
          {
            "answer": "¡De nada! Es un placer para mí asistir en la socialización de la investigación de FUNDACREDESA."
          }
        ]
      }
    }
  },
